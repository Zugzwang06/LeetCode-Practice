        "!pip install -q transformers datasets trl peft accelerate\n",
        "import torch\n",
        "import transformers\n",
        "import datasets\n",
        "import trl\n",
        "import peft\n",
        "\n",
        "print(\"PyTorch:\", torch.__version__)\n",
        "print(\"GPU available:\", torch.cuda.is_available())\n",
        "\n",
        "if torch.cuda.is_available():\n",
        "    print(\"GPU:\", torch.cuda.get_device_name(0))\n",
        "    from transformers import AutoTokenizer, AutoModelForCausalLM\n",
        "\n",
        "model_name = \"Qwen/Qwen2.5-0.5B\"\n",
        "\n",
        "tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
        "model = AutoModelForCausalLM.from_pretrained(model_name)\n",
        "\n",
        "print(\"Model loaded!\")\n",
        "print(\"GPU for Hardware Accelerator is being used\")\n",
        "print(\"Parameters:\", sum(p.numel() for p in model.parameters()))\n",
        "\n",
        "prompt = \"Explain what XOR is to a college student.\"\n",
        "\n",
        "inputs = tokenizer(prompt, return_tensors=\"pt\").to(model.device)\n",
        "\n",
        "outputs = model.generate(\n",
        "    **inputs,\n",
        "    max_new_tokens=100\n",
        ")\n",
        "\n",
        "response = tokenizer.decode(outputs[0], skip_special_tokens=True)\n",
        "\n",
        "print(response)\n",
        "from datasets import Dataset\n",
        "\n",
        "data = {\n",
        "    \"prompt\": [\n",
        "        \"What is XOR?\",\n",
        "        \"What does a binary 1 represent?\",\n",
        "        \"What is a truth table?\",\n",
        "        \"What is a logic gate?\",\n",
        "    ],\n",
        "    \"response\": [\n",
        "        \"XOR is a logical operation that outputs 1 when exactly one of its inputs is 1.\",\n",
        "        \"In Boolean logic, 1 commonly represents TRUE or an asserted logical state.\",\n",
        "        \"A truth table lists every possible combination of inputs to a logical expression and shows the resulting output.\",\n",
        "        \"A logic gate is a circuit that performs a Boolean logical operation on one or more inputs.\",\n",
        "    ]\n",
        "}\n",
        "\n",
        "dataset = Dataset.from_dict(data)\n",
        "\n",
        "print(dataset)\n",
        "print(\"GPU available:\", torch.cuda.is_available())\n",
        "print(\"GPU:\", torch.cuda.get_device_name(0))\n",
        "def format_example(example):\n",
        "    return f\"\"\"### Question:\n",
        "{example['prompt']}\n",
        "\n",
        "### Answer:\n",
        "{example['response']}\"\"\"\n",
        "\n",
        "formatted_dataset = dataset.map(\n",
        "    lambda x: {\"text\": format_example(x)}\n",
        ")\n",
        "\n",
        "print(formatted_dataset[0][\"text\"])\n",
        "from peft import LoraConfig\n",
        "lora_config = LoraConfig(\n",
        "    r=8,\n",
        "    lora_alpha=16,\n",
        "    lora_dropout=0.05,\n",
        "    target_modules=[\"q_proj\", \"v_proj\"],\n",
        "    task_type=\"CAUSAL_LM\"\n",
        ")"
